# Generic register map support.  There are no user servicable options here,
# this is an API intended to be used by other kernel subsystems.  These
# subsystems should select the appropriate symbols.

config REGMAP
	bool

config REGMAP_KUNIT
	tristate "KUnit tests for regmap"
	depends on KUNIT && REGMAP
	default KUNIT_ALL_TESTS
	select REGMAP_RAM

config REGMAP_BUILD
	bool "Enable regmap build"
	depends on KUNIT
	select REGMAP
	help
	  This option exists purely to allow the regmap KUnit tests to
	  be enabled without having to enable some driver that uses
	  regmap due to unfortunate issues with how KUnit tests are
	  normally enabled.

config REGMAP_AC97
	tristate
	imply REGMAP

config REGMAP_I2C
	tristate
	depends on I2C
	imply REGMAP

config REGMAP_SLIMBUS
	tristate
	depends on SLIMBUS
	imply REGMAP

config REGMAP_SPI
	tristate
	depends on SPI
	imply REGMAP

config REGMAP_SPMI
	tristate
	depends on SPMI
	imply REGMAP

config REGMAP_W1
	tristate
	depends on W1
	imply REGMAP

config REGMAP_MDIO
	tristate
	depends on PHYLIB
	imply REGMAP

config REGMAP_MMIO
	tristate
	imply REGMAP

config REGMAP_IRQ
	bool
	select IRQ_DOMAIN
	imply REGMAP

config REGMAP_RAM
	tristate

config REGMAP_SOUNDWIRE
	tristate
	depends on SOUNDWIRE
	imply REGMAP

config REGMAP_SOUNDWIRE_MBQ
	tristate
	depends on SOUNDWIRE
	imply REGMAP

config REGMAP_SCCB
	tristate
	depends on I2C
	imply REGMAP

config REGMAP_I3C
	tristate
	depends on I3C
	imply REGMAP

config REGMAP_SPI_AVMM
	tristate
	depends on SPI
	imply REGMAP

config REGMAP_FSI
	tristate
	depends on FSI
	imply REGMAP
